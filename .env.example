# Copie para .env (que NUNCA vai para o Git) e preencha localmente.
# Em produção, estes valores ficam só nos painéis da Vercel / GitHub Secrets.

# apps/server
PORT=3000
# Sem DATABASE_URL/REDIS_URL o servidor roda em memória (só para desenvolvimento).
# DATABASE_URL=postgres://postgres@localhost:5432/krdesk
# DATABASE_URL_UNPOOLED=   (migrações; opcional)
# REDIS_URL=redis://localhost:6379
# CF_TURN_KEY_ID=          (opcional — sem ele, só STUN)
# CF_TURN_API_TOKEN=
# WS_MAX_LIFETIME_MS=270000
# Testes de integração com serviços reais:
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/krdesk_test
# TEST_REDIS_URL=redis://localhost:6379/1
